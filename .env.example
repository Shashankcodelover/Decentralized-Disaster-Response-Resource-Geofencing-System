# MongoDB
MONGO_URI=mongodb://localhost:27017/mirage

# Redis
REDIS_URL=redis://localhost:6379

# JWT — REQUIRED: Server will NOT start without this
JWT_SECRET=GENERATE_A_SECURE_RANDOM_STRING_HERE

# FEMA Compliance HMAC Signing Key — required for signed SITREP reports
COMPLIANCE_SIGNING_KEY=GENERATE_A_SEPARATE_SIGNING_KEY_HERE

# Server
PORT=4000
NODE_ENV=development

# CORS — comma-separated allowed origins
CORS_ORIGIN=http://localhost:5173

# WebRTC STUN/TURN
STUN_SERVER=stun:stun.l.google.com:19302
TURN_SERVER=
TURN_USERNAME=
TURN_CREDENTIAL=

# Mapbox (optional, Leaflet works without it)
MAPBOX_TOKEN=

